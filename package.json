{
  "name": "android-emu",
  "displayName": "android-emu",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "android-emu.start",
        "title": "Start",
        "category": "Android Emulator"
      },
      {
        "command": "android-emu.screenshot",
        "title": "Take Screenshot",
        "category": "Android Emulator"
      },
      {
        "command": "android-emu.rotateLandscape",
        "title": "Rotate Landscape",
        "category": "Android Emulator"
      },
      {
        "command": "android-emu.rotatePortrait",
        "title": "Rotate Portrait",
        "category": "Android Emulator"
      },
      {
        "command": "android-emu.startExpoGo",
        "title": "Start with Expo Go",
        "category": "Android Emulator"
      },
      {
        "command": "android-emu.startExpoNative",
        "title": "Start with Expo Native Binary",
        "category": "Android Emulator"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}